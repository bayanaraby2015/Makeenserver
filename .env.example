APP_NAME="منصة مكين"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Riyadh
APP_URL=http://localhost

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=makeen
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@makeen.local"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# Makeen-specific configuration
# -----------------------------------------------------------------------------
MAKEEN_VAT_RATE=0.15
MAKEEN_INITIATIVE_DURATION_MONTHS=32
MAKEEN_DEFAULT_TIMEZONE=Asia/Riyadh

# Lock the activity log against tampering in production. Defaults to false in
# local development so seeders / tests can prune entries. Set to true on
# production servers.
ACTIVITY_LOG_LOCKED=false

# -----------------------------------------------------------------------------
# Super admin (required for seeding the first account)
# -----------------------------------------------------------------------------
SUPER_ADMIN_EMAIL=admin@makeen.local
SUPER_ADMIN_NAME="مدير النظام"
# Leave SUPER_ADMIN_PASSWORD empty in production and the seeder will generate
# a random one (printed once to stdout). Always set a real value below in dev.
SUPER_ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# Optional: Zoom integration (also configurable from the admin panel)
# -----------------------------------------------------------------------------
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_USER_ID=
